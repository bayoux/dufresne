{
  "compilerOptions": {
    // Core
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,

    // Native runtime: files must run under Node's type stripping
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true

    // Aliases for cross-item imports inside published item sources
    // (`import { x } from '#utils/x/x'`) come from package.json's `imports`
    // field, not from `paths` here — nodenext resolves both the same way
    // Node does at runtime, so there's one source of truth instead of two
    // that can drift.
  },
  "include": ["cli/**/*.ts", "scripts/**/*.ts", "src/**/*.ts", "tsdown.config.ts"]
}
