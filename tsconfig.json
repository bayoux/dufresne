{
  "compilerOptions": {
    // Core
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,

    // Native runtime: files must run under Node's type stripping
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,

    // Alias used inside published item sources; resolved/rewritten by the CLI.
    // Convention: `import { x } from '@/utils/x/x'` (folder-per-item).
    "paths": {
      "@/utils/*": ["./src/utils/*"],
      "@/helpers/*": ["./src/helpers/*"]
    }
  },
  "include": ["cli/**/*.ts", "scripts/**/*.ts", "src/**/*.ts", "tsdown.config.ts"]
}
