{
  "name": "dufresne",
  "version": "0.0.11",
  "bin": {
    "dufresne": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "registry": "node scripts/build-registry.ts",
    "start": "node cli/index.ts",
    "dev": "node --watch cli/index.ts",
    "test": "node --test",
    "lint": "tsc --noEmit",
    "check:registry": "node scripts/build-registry.ts && git diff --exit-code -- registry.json",
    "check": "pnpm run lint && pnpm run test && pnpm run check:registry",
    "build": "node scripts/build-registry.ts && tsdown",
    "release": "release-it",
    "prepublishOnly": "pnpm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bayoux/dufresne.git"
  },
  "keywords": [
    "utils",
    "underscore",
    "lodash",
    "helpers"
  ],
  "author": "dayan",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/bayoux/dufresne/issues"
  },
  "homepage": "https://github.com/bayoux/dufresne#readme",
  "devDependencies": {
    "@types/node": "^25.6.0",
    "release-it": "^20.0.1",
    "tsdown": "^0.15.6",
    "typescript": "^7.0.0"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0"
  }
}
